// Example / documentation: same structure as firestore.rules (merge paths if you split files).
// Deploy: Firebase Console → Firestore → Rules → Publish
//
// Prerequisites: Authentication → Email/Password enabled; same project as firebase-config.js

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Transfer Tracker & Transfer Submit (per-board path; ?tracker= on tracker + submit URLs) ---
    match /transferTrackers/{tid}/submissions/{docId} {
      allow read, create, update, delete: if tid is string
        && tid.size() >= 12
        && tid.size() <= 80
        && tid.matches('^[a-z0-9_-]+$');
    }

    match /transferSubmissions/{docId} {
      allow read, create, update, delete: if false;
    }

    // --- Account: localStorage sync (account.html Sync/Restore; account-sync-global.js on tools) ---
    // Rare Soil War Tracker: data is in this blob (key lastwar-rare-soil-war-tracker-v1). Live link = RTDB.
    match /userLocalStorageSync/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Account: profile (account.html; account-nav-chip.js) ---
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Account: usernames (account.html, account-auth-modal.js) ---
    // get only (not list) — app uses getDoc per name; blocks bulk enumeration of email/uid.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
